# Copy to .env.release.local (ignored). Never commit real settings or credentials.
LEMMA_REPOSITORY_URL=https://github.com/your-organization/lemma
VITE_REPOSITORY_URL=https://github.com/your-organization/lemma
LEMMA_PUBLIC_URL=https://example.org
LEMMA_DOMAIN=example.org
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
LEMMA_DOWNLOADS_DATABASE_ID=00000000-0000-0000-0000-000000000000
# Prefer a certificate SHA-1 from `security find-identity -v -p codesigning`.
LEMMA_SIGN_IDENTITY=YOUR_DEVELOPER_ID_CERTIFICATE_SHA1
LEMMA_NOTARY_PROFILE=lemma-notary
# Alternatively, omit the profile and reference an ignored file with APPLE_ID,
# APPLE_TEAM_ID, and APPLE_APP_PASSWORD. Values are loaded only for notarytool.
# LEMMA_NOTARY_ENV_FILE=/absolute/path/to/private.env
# Generate a random token with at least 32 characters. Do not use an account password.
LEMMA_STATS_TOKEN=
# Optional for an existing multi-account wrapper; otherwise the pinned local CLI is used.
# LEMMA_CLOUDFLARE_PROFILE=personal
# LEMMA_WRANGLER_WRAPPER=/absolute/path/to/wrangler-wrapper
