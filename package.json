{
  "name": "lemma-math",
  "productName": "Lemma",
  "version": "0.3.9",
  "private": true,
  "description": "A quiet place to think in words and equations",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "npm@11.8.0",
  "scripts": {
    "build": "node scripts/notices.mjs && vite build",
    "start": "electron .",
    "test": "node --conditions=browser --conditions=development --test tests/*.test.mjs",
    "package": "npm run package:mac",
    "package:mac": "npm run build && node scripts/package-desktop.mjs darwin arm64",
    "package:windows": "npm run build && node scripts/package-desktop.mjs win32 x64",
    "site:build": "vite build --config site/vite.config.js",
    "site:dev": "vite --config site/vite.config.js --host 0.0.0.0",
    "release:mac": "node --env-file-if-exists=.env.release.local scripts/release-mac.mjs",
    "release:prepare": "node --env-file-if-exists=.env.release.local scripts/publish-release.mjs",
    "release:publish": "node --env-file-if-exists=.env.release.local scripts/publish-release.mjs --publish",
    "release:promote": "node --env-file-if-exists=.env.release.local scripts/publish-release.mjs --promote-only",
    "cloudflare:configure": "node --env-file-if-exists=.env.release.local scripts/cloudflare.mjs configure",
    "cloudflare:migrate": "node --env-file-if-exists=.env.release.local scripts/cloudflare.mjs migrate",
    "cloudflare:deploy": "node --env-file-if-exists=.env.release.local scripts/cloudflare.mjs deploy",
    "cloudflare:stats-secret": "node --env-file-if-exists=.env.release.local scripts/cloudflare.mjs stats-secret"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/merriweather": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource-variable/roboto-slab": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/work-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",
    "lucide": "0.468.0",
    "mathlive": "0.111.4"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.5.0",
    "happy-dom": "21.0.4",
    "vite": "8.3.8",
    "wrangler": "4.164.0"
  },
  "license": "MIT"
}
